source "https://rubygems.org"

# ---------------------------------------------------------------------------
# Local development only.
#
# GitHub Pages builds this site server-side using its own Jekyll toolchain and
# the `remote_theme` setting in _config.yml, so this Gemfile is *not* what runs
# in production. It exists so `bundle exec jekyll serve` gives a faithful local
# preview. Only stock, GitHub-Pages-supported plugins are listed, which keeps
# local and production output equivalent.
# ---------------------------------------------------------------------------

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
  gem "jekyll-paginate", "~> 1.1"
  gem "jekyll-include-cache", "~> 0.2"
  gem "jekyll-remote-theme", "~> 0.4"
end

# Ruby 3.4+ removed these from the default gem set; Jekyll still needs them.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "webrick", "~> 1.8"

# Windows / JRuby lack zoneinfo files.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
